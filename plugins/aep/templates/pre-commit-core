#!/bin/sh
# AEP core pre-commit hook: checks that need no platform. Installed by /aep:frame;
# /aep:platform replaces it with the chosen profile's hook.
# Enable once per clone:  git config core.hooksPath .githooks
set -e

PY=""
for p in python3 python py; do
  if command -v "$p" >/dev/null 2>&1 && "$p" -c "import sys" >/dev/null 2>&1; then PY="$p"; break; fi
done
if [ -z "$PY" ]; then echo "pre-commit: Python 3.9+ not found (see SETUP.md)"; exit 1; fi

echo "pre-commit: traceability"
"$PY" scripts/process/traceability.py >/dev/null || {
  "$PY" scripts/process/traceability.py; exit 1;
}

if command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: secret scan"
  gitleaks protect --staged --redact
else
  echo "pre-commit: gitleaks not installed, secret scan skipped (CI still runs it)"
fi
